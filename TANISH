<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Tanish ❤️</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,sans-serif;
  background:#070012;
  color:white;
  overflow-x:hidden;
}

section{
  min-height:100vh;
  padding:45px 18px;
  display:flex;
  align-items:center;
  justify-content:center;
}

.container{
  width:100%;
  max-width:950px;
  text-align:center;
}

.card{
  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.14);
  border-radius:30px;
  padding:35px 25px;
  backdrop-filter:blur(14px);
  box-shadow:0 20px 70px rgba(0,0,0,.45);
}

button{
  border:0;
  border-radius:50px;
  padding:16px 28px;
  margin-top:20px;
  font-size:17px;
  font-weight:bold;
  color:white;
  background:linear-gradient(90deg,#ff3cac,#784ba0);
  box-shadow:0 10px 30px rgba(255,60,172,.3);
  cursor:pointer;
  transition:.25s;
}

button:active{
  transform:scale(.94);
}

.hero-small{
  font-size:20px;
  margin-bottom:15px;
}

.hero-title{
  font-size:clamp(52px,12vw,95px);
  line-height:.95;
  font-weight:900;
  background:linear-gradient(90deg,#ff58c7,#ffd45c,#69dfff);
  -webkit-background-clip:text;
  color:transparent;
}

.hero-text{
  max-width:700px;
  margin:25px auto;
  font-size:20px;
  line-height:1.7;
}

/* PHOTO */

.photo-frame{
  width:235px;
  height:300px;
  background:white;
  padding:10px;
  margin:30px auto;
  transform:rotate(2deg);
  box-shadow:0 20px 55px rgba(0,0,0,.5);
}

.photo-frame img{
  width:100%;
  height:245px;
  object-fit:cover;
}

.photo-name{
  color:#222;
  font-family:cursive;
  font-size:22px;
  padding-top:10px;
}

/* TITLES */

.section-title{
  font-size:40px;
  margin-bottom:25px;
}

.text{
  font-size:19px;
  line-height:1.9;
  max-width:760px;
  margin:auto;
}

/* STORY */

.story-flow{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
  margin:30px 0;
}

.story-box{
  padding:17px 20px;
  border-radius:18px;
  background:rgba(255,255,255,.08);
}

.arrow{
  font-size:28px;
  color:#ff4db8;
}

/* GAME */

#game{
  background:
  radial-gradient(circle at 50% 20%,#3f1b8a,#07000f 65%);
}

.question{
  font-size:24px;
  line-height:1.5;
  margin:30px 0;
}

.option{
  width:100%;
  margin:9px 0;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.15);
}

#gameResult{
  min-height:55px;
  margin-top:20px;
  font-size:20px;
  font-weight:bold;
}

/* LETTER */

.letter{
  max-width:760px;
  margin:auto;
  text-align:left;
  padding:30px 25px;
  border-radius:25px;
  background:rgba(255,255,255,.06);
  font-size:19px;
  line-height:1.9;
}

.letter p{
  margin-bottom:20px;
}

/* LOCATION */

.distance{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:30px;
  flex-wrap:wrap;
  margin:35px 0;
}

.location{
  padding:20px;
  font-size:20px;
  line-height:1.6;
}

.heart{
  font-size:55px;
  animation:heartbeat 1.3s infinite;
}

@keyframes heartbeat{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.2)}
}

/* FINAL */

#final{
  background:
  radial-gradient(circle at 50% 35%,#ff2eaa55,transparent 32%),
  radial-gradient(circle at 20% 75%,#304ffe55,transparent 35%),
  #05000b;
}

.cake{
  font-size:90px;
  animation:float 2s infinite alternate;
}

@keyframes float{
  from{transform:translateY(0)}
  to{transform:translateY(-15px)}
}

.final-title{
  font-size:clamp(45px,11vw,85px);
  line-height:1;
  font-weight:900;
  background:linear-gradient(90deg,#ff4db8,#ffd34d,#65d9ff);
  -webkit-background-clip:text;
  color:transparent;
}

.final-message{
  max-width:750px;
  margin:30px auto;
  font-size:20px;
  line-height:1.9;
}

#secret{
  display:none;
  margin-top:30px;
  font-size:27px;
  line-height:1.6;
  color:#ffd34d;
}

/* PARTICLES */

.particle{
  position:fixed;
  pointer-events:none;
  z-index:999;
  animation:fall linear forwards;
}

@keyframes fall{
  from{
    transform:translateY(-50px) rotate(0);
    opacity:1;
  }
  to{
    transform:translateY(110vh) rotate(360deg);
    opacity:0;
  }
}

@media(max-width:600px){

  .card{
    padding:28px 17px;
  }

  .section-title{
    font-size:33px;
  }

  .text,
  .letter{
    font-size:17px;
  }

}
</style>
</head>

