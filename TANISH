<script>

/* ================= VOICE ================= */

function speak(text){

  if(!("speechSynthesis" in window)) return;

  speechSynthesis.cancel();

  let voices=speechSynthesis.getVoices();

  let male=voices.find(v=>{
    let n=v.name.toLowerCase();
    let l=v.lang.toLowerCase();

    return l.includes("hi") &&
    (
      n.includes("male") ||
      n.includes("man") ||
      n.includes("ravi") ||
      n.includes("madhur")
    );
  });

  if(!male){
    male=voices.find(v=>
      v.lang.toLowerCase().includes("hi")
    );
  }

  let u=new SpeechSynthesisUtterance(text);

  u.lang="hi-IN";
  u.rate=.88;
  u.pitch=.75;
  u.volume=1;

  if(male) u.voice=male;

  speechSynthesis.speak(u);
}


/* ================= NAVIGATION ================= */

function goTo(id){

  document.getElementById(id)
  .scrollIntoView({
    behavior:"smooth"
  });

}


/* ================= START ================= */

function startSurprise(){

  speak(
    "Oye Tanish! Kya haal hai birthday boy? Aaj ka din sirf tumhara hai. Maine tere liye kuch alag banaya hai. Dhyaan se dekhna."
  );

  createParticles();

  setTimeout(function(){
    goTo("story");
  },1200);

}


/* ================= GAME ================= */

function answer(choice){

  let result=
    document.getElementById("gameResult");

  document.querySelectorAll(".option")
    .forEach(b=>b.disabled=true);

  if(choice===3){

    result.innerHTML=
      "😂🔥 MUJHE PATA THA! TEENO!";

    speak(
      "Mujhe pata tha! Teeno choose karega. Sahi jawab!"
    );

    createParticles();

  }else{

    result.innerHTML=
      "😂 Achhaaa... interesting choice!";

    speak(
      "Achhaaa... interesting choice!"
    );

  }

  document.getElementById("gameNext")
    .style.display="inline-block";
}


function finishGame(){

  speak(
    "Game khatam! Ab thodi dil ki baat karte hain."
  );

  goTo("message");

}


/* ================= SECRET ================= */

function showSecret(){

  document.getElementById("secret")
    .style.display="block";

  speak(
    "Bas ek baat yaad rakhna. Tu chhota bhai hai, par apna hai."
  );

  createParticles();

}


/* ================= PARTICLES ================= */

function createParticles(){

  const icons=[
    "✨",
    "🎉",
    "🎊",
    "❤️",
    "⭐",
    "💫"
  ];

  for(let i=0;i<35;i++){

    let p=
      document.createElement("div");

    p.className="particle";

    p.innerText=
      icons[
        Math.floor(
          Math.random()*icons.length
        )
      ];

    p.style.left=
      Math.random()*100+"vw";

    p.style.fontSize=
      (15+Math.random()*25)+"px";

    p.style.animationDuration=
      (3+Math.random()*4)+"s";

    document.body.appendChild(p);

    setTimeout(()=>{
      p.remove();
    },7000);

  }

}


/* ================= VOICE LOAD ================= */

if("speechSynthesis" in window){

  speechSynthesis.onvoiceschanged=
  function(){
    speechSynthesis.getVoices();
  };

}

</script>

